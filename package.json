{
  "name": "breakdancer",
  "version": "4.2.3",
  "description": "A breakpoint tracking utility",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:godaddy/breakdancer.git"
  },
  "keywords": [
    "breakpoints",
    "breakdancer",
    "breakpoint",
    "tracking",
    "break",
    "point"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.27.7",
    "rollup": "^4.60.4",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "propget": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
